# Copy to .env (never commit .env). Pick ONE AI backend:
#   claude  -> needs ANTHROPIC_API_KEY
#   granite -> IBM Granite running locally: install Ollama, then `ollama pull granite3.3:8b`
#   offline -> no model; the app still runs (safe default for demos)
AI_PROVIDER=offline

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

GRANITE_MODEL=granite3.3:8b
OLLAMA_URL=http://localhost:11434
